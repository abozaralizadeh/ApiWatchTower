# Copy this file to .env (git-ignored) next to docker-compose.yml and fill in every value:
# docker compose refuses to start while a password is empty.
# Docker Compose reads .env automatically. Values are used literally when wrapped in single quotes,
# so quote a value that contains a $ sign.
#
# Existing install: Postgres and Grafana apply their passwords only when their data is first
# created, so put the values your current volumes were created with here, not new ones.

# Password of the Postgres "postgres" user; the AWT containers receive it as AWT_PG_PASSWORD.
POSTGRES_PASSWORD=

# Password of the Grafana "admin" user.
GF_SECURITY_ADMIN_PASSWORD=

# Django secret key: a long random string, for example the output of
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Left empty, a new random key is generated at every start and sessions do not survive restarts.
AWT_SECRET_KEY=
